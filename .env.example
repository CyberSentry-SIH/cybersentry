# CyberSentry V1 - Environment Template
ENVIRONMENT=development
APP_NAME=CyberSentry
APP_VERSION=1.0.0
DEBUG=True
HOST=0.0.0.0
PORT=8000

SECRET_KEY=change-this-to-a-secure-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

DATABASE_URL=sqlite:///./cybersentry.db
# For Production Docker deployment:
# DATABASE_URL=postgresql://postgres:your-secure-password@postgres:5432/cybersentry
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your-secure-password
# POSTGRES_DB=cybersentry
EVIDENCE_STORAGE_PATH=./evidence_store
MAX_UPLOAD_SIZE_BYTES=26214440

GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
ENABLE_LLM=False

ENABLE_EXTERNAL_INTEL=False
VIRUSTOTAL_API_KEY=

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
